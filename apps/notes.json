{
  "appId": "io.floatsuite.notes",
  "productName": "Notebase",
  "copyright": "Copyright © 2025 Arik Closs Novais",
  "directories": {
    "output": "electron/dist/notes",
    "buildResources": "electron/build"
  },
  "files": [
    "index.html",
    "notes.html",
    "shared/**/*",
    "favicons/**/*",
    "electron/main-notes.js",
    "electron/preload.js"
  ],
  "publish": null,
  "linux": {
    "icon": "favicons/notes-512.png",
    "category": "Office",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "deb",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "rpm",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "pacman",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "AppImage",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "maintainer": "Arik Closs Novais",
    "vendor": "Float Suite",
    "synopsis": "Local-first Markdown knowledge base",
    "executableName": "notebase",
    "desktop": {
      "Name": "Notebase",
      "Comment": "Local-first Markdown knowledge base",
      "Categories": "Office;Utility;TextEditor;",
      "Keywords": "notes;markdown;knowledge;wiki;float;",
      "StartupWMClass": "Notebase",
      "Icon": "notebase"
    }
  },
  "deb": {
    "depends": [
      "libnotify4",
      "libxtst6",
      "libnss3"
    ],
    "category": "Office",
    "artifactName": "${productName}-${version}-${arch}.deb"
  },
  "rpm": {
    "depends": [
      "libnotify",
      "libXtst",
      "nss"
    ],
    "category": "Office",
    "artifactName": "${productName}-${version}-${arch}.rpm"
  },
  "mac": {
    "icon": "favicons/notes-512.png",
    "category": "public.app-category.productivity",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "electron/build/entitlements.mac.plist",
    "entitlementsInherit": "electron/build/entitlements.mac.plist"
  },
  "dmg": {
    "title": "Notebase ${version}",
    "artifactName": "Notebase-${version}-${arch}.dmg",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "icon": "favicons/notes.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Notebase-Setup-${version}-${arch}.exe",
    "shortcutName": "Notebase"
  },
  "portable": {
    "artifactName": "Notebase-Portable-${version}-${arch}.exe"
  },
  "extraMetadata": {
    "main": "electron/main-notes.js",
    "name": "notebase",
    "productName": "Notebase",
    "description": "Local-first Markdown knowledge base"
  }
}
